# =========================================================================
# PREMJI GROUPS ENTERPRISE OPERATIONS PORTAL - ENVIRONMENT TEMPLATE (.env.example)
# =========================================================================

# --- 1. Express Server Configuration ---
PORT=3000
NODE_ENV=production

# --- 2. Production MySQL Database Connection ---
MYSQL_HOST="your-mysql-hostname"
MYSQL_PORT=3306
MYSQL_USER="your-mysql-user"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_DATABASE="your-mysql-database"

# --- 3. JWT Security Configuration ---
JWT_SECRET="super-secret-random-32-character-key"

# --- 4. VPS SFTP Dedicated Image Storage ---
SFTP_HOST="72.60.202.149"
SFTP_PORT=22
SFTP_USER="tools"
SFTP_PASSWORD="your-sftp-password"
SFTP_REMOTE_BASE="/var/www/premji"
NEXT_PUBLIC_CDN_BASE="http://72.60.202.149/premji"

# --- 5. Automated 31-Day Retention Policy Cleanup ---
CRON_SECRET="your-cron-secret-token"
